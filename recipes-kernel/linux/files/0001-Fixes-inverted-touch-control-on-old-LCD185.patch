From f95e773146911c7ca20944e8d8aba7bb6c6aa8b7 Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Thu, 21 Aug 2025 22:19:23 +0000
Subject: [PATCH] Fixes inverted touch control on old LCD185

Signed-off-by: tloan <tloan@phytec.com>
---
 arch/arm64/boot/dts/ti/k3-am62-phyboard-lyra-oldi-lcd185.dtso | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/ti/k3-am62-phyboard-lyra-oldi-lcd185.dtso b/arch/arm64/boot/dts/ti/k3-am62-phyboard-lyra-oldi-lcd185.dtso
index 3466890ee947..33201b027feb 100644
--- a/arch/arm64/boot/dts/ti/k3-am62-phyboard-lyra-oldi-lcd185.dtso
+++ b/arch/arm64/boot/dts/ti/k3-am62-phyboard-lyra-oldi-lcd185.dtso
@@ -98,6 +98,8 @@ touchscreen@5d {
 
 		reset-gpios = <&main_gpio0 18 GPIO_ACTIVE_HIGH>;
 		irq-gpios = <&main_gpio0 19 GPIO_ACTIVE_HIGH>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
 	};
 };
 
