+typedef struct {
+    lv_obj_t   *label;
+    lv_timer_t *timer;
+    time_t      target;
+    bool        inclusive;   // true => ceil days (counts today), false => floor
+} countdown_ctx_t;
+
+static long compute_days_left(time_t now, time_t target, bool inclusive) {
+    double secs = difftime(target, now);
+    double days = secs / 86400.0;
+    long   d = inclusive ? (long)ceil(days) : (long)floor(days);
+    if (d < 0) d = 0;
+    return d;
+}
+
+static void countdown_tick_cb(lv_timer_t *t) {
+    countdown_ctx_t *ctx = (countdown_ctx_t *)lv_timer_get_user_data(t);
+    long d = compute_days_left(time(NULL), ctx->target, ctx->inclusive);
+
+    char buf[48];
+    snprintf(buf, sizeof(buf), "%ld day%s left", d, (d == 1) ? "" : "s");
+    lv_label_set_text(ctx->label, buf);
+}
+
+static void countdown_cleanup_cb(lv_event_t *e) {
+    countdown_ctx_t *ctx = (countdown_ctx_t *)lv_event_get_user_data(e);
+    if (ctx->timer) lv_timer_del(ctx->timer);
+    free(ctx);
+}
+
+/* Create a countdown label.
+ * parent: where to place it (e.g., your banner or lv_scr_act())
+ * (year,month,day): target date (local time), month=1..12
+ * align/x_ofs/y_ofs: standard LVGL placement
+ * inclusive_today: true => counts partial days as a full day (ceil)
+ */
+static lv_obj_t *add_day_countdown(lv_obj_t *parent,
+                                   int year, int month, int day,
+                                   lv_align_t align, lv_coord_t x_ofs, lv_coord_t y_ofs,
+                                   bool inclusive_today)
+{
+    // Build a midnight target time in local time
+    struct tm tm_target = {0};
+    tm_target.tm_year = year - 1900;
+    tm_target.tm_mon  = month - 1;
+    tm_target.tm_mday = day;
+    tm_target.tm_hour = 0; tm_target.tm_min = 0; tm_target.tm_sec = 0;
+
+    time_t target = mktime(&tm_target);
+
+    // Create label
+    lv_obj_t *lbl = lv_label_create(parent);
+    lv_obj_set_style_text_font(lbl, &lv_font_montserrat_48, 0);
+    lv_obj_set_style_text_align(lbl, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_width(lbl, LV_SIZE_CONTENT);
+    lv_obj_align(lbl, align, x_ofs, y_ofs);
+
+    // Context + timer
+    countdown_ctx_t *ctx = (countdown_ctx_t *)malloc(sizeof(countdown_ctx_t));
+    ctx->label = lbl;
+    ctx->target = target;
+    ctx->inclusive = inclusive_today;
+    ctx->timer = lv_timer_create(countdown_tick_cb, 1000, ctx); // 1s updates
+
+    // Clean up when label is deleted
+    lv_obj_add_event_cb(lbl, countdown_cleanup_cb, LV_EVENT_DELETE, ctx);
+
+    // Initial text
+    countdown_tick_cb(ctx->timer);
+    return lbl;
+}
+
+static void label_make_filled_box(lv_obj_t *lbl, lv_color_t bg, lv_opa_t bg_opa, lv_color_t border, int border_w, int radius, int pad_x, int pad_y)
+{
+    // wrapping helps if you later set a max width
+    lv_label_set_long_mode(lbl, LV_LABEL_LONG_WRAP);
+
+    // background fill
+    lv_obj_set_style_bg_color(lbl, bg, 0);
+    lv_obj_set_style_bg_opa(lbl, bg_opa, 0);
+
+    // border
+    lv_obj_set_style_border_color(lbl, border, 0);
+    lv_obj_set_style_border_opa(lbl, bg_opa, 0);
+    lv_obj_set_style_border_width(lbl, border_w, 0);
+
+    // rounded corners + padding
+    lv_obj_set_style_radius(lbl, radius, 0);
+    lv_obj_set_style_pad_left(lbl,   pad_x, 0);
+    lv_obj_set_style_pad_right(lbl,  pad_x, 0);
+    lv_obj_set_style_pad_top(lbl,    pad_y, 0);
+    lv_obj_set_style_pad_bottom(lbl, pad_y, 0);
+}
